# ============================================================================
# BoardGameRules — Environment Variables Configuration
# ============================================================================
# Copy this file to `.env` and fill in your credentials for local runs.
# `.env` is gitignored (and excluded from Docker images) so local URLs and
# secrets are never committed to GitHub or baked into production containers.

# --- Google Gemini AI & Embeddings (https://aistudio.google.com/apikey) -----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_SEARCH_MODEL="gemini-2.5-flash"

# --- Qdrant Vector Store ----------------------------------------------------
# Local Docker (start with `docker compose up -d qdrant`):
#   - REST API:      http://localhost:6333
#   - Web Dashboard: http://localhost:6333/dashboard
# In-Memory mode:    QDRANT_URL=":memory:"
# Qdrant Cloud:      QDRANT_URL="https://your-cluster-id.region.aws.cloud.qdrant.io:6333"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="rulebook_chunks"
QDRANT_VECTOR_SIZE="768"

# --- MongoDB NoSQL Persistence ----------------------------------------------
# Local Docker: start with `docker compose up -d mongodb`
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="boardgamerules"

# --- Centralized Logging ----------------------------------------------------
# LOG_LEVEL:  DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: console (local dev -> stderr) | json (GCP Cloud Run -> stdout)
LOG_LEVEL="INFO"
LOG_FORMAT="console"
